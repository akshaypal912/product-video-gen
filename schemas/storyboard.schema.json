{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product-video-gen.local/schemas/storyboard.schema.json",
  "title": "Product Launch Video Storyboard",
  "description": "Structured storyboard data that populates fixed HyperFrames scene templates. The LLM emits only this JSON — never HTML, CSS, JS, or GSAP.",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenes"],
  "properties": {
    "audio": {
      "$ref": "#/$defs/audioConfig"
    },
    "scenes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/scene"
      },
      "description": "Ordered scene list. Must start with logo-intro and end with cta-outro (start/end enforced by scripts/validate-storyboard.mjs). Duration is in frames at 30 FPS."
    }
  },
  "$defs": {
    "durationFrames": {
      "type": "integer",
      "minimum": 30,
      "maximum": 180,
      "description": "Scene duration in integer frames at 30 FPS (1–6 seconds)."
    },
    "narrativeRole": {
      "type": "string",
      "enum": [
        "hook",
        "friction",
        "problem",
        "reveal",
        "proof",
        "ecosystem",
        "benefit",
        "cta",
        "close"
      ],
      "description": "Narrative intent for the scene. friction aliases problem; cta aliases close. Optional on older storyboards."
    },
    "sceneVoiceover": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "script": { "type": "string", "minLength": 0, "maxLength": 240 }
      }
    },
    "audioConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "music": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "mood": { "type": "string", "minLength": 0, "maxLength": 80 }
          }
        },
        "voiceover": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "script": { "type": "string", "minLength": 0, "maxLength": 800 },
            "tone": { "type": "string", "minLength": 0, "maxLength": 80 },
            "pace": {
              "type": "string",
              "enum": ["natural", "measured", "urgent"]
            }
          }
        }
      }
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$",
      "description": "CSS hex color: #RGB, #RRGGBB, or #RRGGBBAA."
    },
    "nonEmptyLine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": ".*\\S.*"
    },
    "logoIntroScene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "duration", "props"],
      "properties": {
        "type": {
          "const": "logo-intro"
        },
        "duration": true,
        "role": {
          "$ref": "#/$defs/narrativeRole"
        },
        "voiceover": {
          "$ref": "#/$defs/sceneVoiceover"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": ["productName"],
          "properties": {
            "productName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": ".*\\S.*"
            }
          }
        }
      }
    },
    "textRevealScene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "duration", "props"],
      "properties": {
        "type": {
          "const": "text-reveal"
        },
        "duration": true,
        "role": {
          "$ref": "#/$defs/narrativeRole"
        },
        "voiceover": {
          "$ref": "#/$defs/sceneVoiceover"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lines"],
          "properties": {
            "lines": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "$ref": "#/$defs/nonEmptyLine"
              }
            }
          }
        }
      }
    },
    "statCalloutScene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "duration", "props"],
      "properties": {
        "type": {
          "const": "stat-callout"
        },
        "duration": true,
        "role": {
          "$ref": "#/$defs/narrativeRole"
        },
        "voiceover": {
          "$ref": "#/$defs/sceneVoiceover"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "suffix", "label"],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": ".*\\S.*"
            },
            "suffix": {
              "type": "string",
              "minLength": 0,
              "maxLength": 20
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": ".*\\S.*"
            }
          }
        }
      }
    },
    "iconGridScene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "duration", "props"],
      "properties": {
        "type": {
          "const": "icon-grid"
        },
        "duration": true,
        "role": {
          "$ref": "#/$defs/narrativeRole"
        },
        "voiceover": {
          "$ref": "#/$defs/sceneVoiceover"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": ["caption", "iconColors"],
          "properties": {
            "caption": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": ".*\\S.*"
            },
            "iconColors": {
              "type": "array",
              "minItems": 2,
              "maxItems": 6,
              "items": {
                "$ref": "#/$defs/hexColor"
              }
            },
            "labels": {
              "type": "array",
              "minItems": 2,
              "maxItems": 6,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": ".*\\S.*"
              }
            }
          }
        }
      }
    },
    "ctaOutroScene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "duration", "props"],
      "properties": {
        "type": {
          "const": "cta-outro"
        },
        "duration": true,
        "role": {
          "$ref": "#/$defs/narrativeRole"
        },
        "voiceover": {
          "$ref": "#/$defs/sceneVoiceover"
        },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "required": ["headline", "sub"],
          "properties": {
            "headline": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": ".*\\S.*"
            },
            "sub": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": ".*\\S.*"
            }
          }
        }
      }
    },
    "scene": {
      "type": "object",
      "required": ["type", "duration", "props"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "logo-intro",
            "text-reveal",
            "stat-callout",
            "icon-grid",
            "cta-outro"
          ]
        },
        "duration": {
          "$ref": "#/$defs/durationFrames"
        },
        "role": {
          "$ref": "#/$defs/narrativeRole"
        },
        "voiceover": {
          "$ref": "#/$defs/sceneVoiceover"
        },
        "props": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "logo-intro"
              }
            },
            "required": ["type"]
          },
          "then": {
            "$ref": "#/$defs/logoIntroScene"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "text-reveal"
              }
            },
            "required": ["type"]
          },
          "then": {
            "$ref": "#/$defs/textRevealScene"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "stat-callout"
              }
            },
            "required": ["type"]
          },
          "then": {
            "$ref": "#/$defs/statCalloutScene"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "icon-grid"
              }
            },
            "required": ["type"]
          },
          "then": {
            "$ref": "#/$defs/iconGridScene"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "cta-outro"
              }
            },
            "required": ["type"]
          },
          "then": {
            "$ref": "#/$defs/ctaOutroScene"
          }
        }
      ]
    }
  }
}
