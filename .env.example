# Server-side only. Never commit a real key. Never put this in web/.

# Storyboard LLM: mistral (implicit default) or ollama.
# Set ollama to use the local Qwen model over Ollama's HTTP API.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b
# OLLAMA_TEMPERATURE=0.1
# OLLAMA_NUM_PREDICT=1400
# OLLAMA_NUM_CTX=4096
# OLLAMA_TIMEOUT_MS=120000

# Used when LLM_PROVIDER=mistral (or LLM_PROVIDER is unset).
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Local Piper TTS (optional). The app does not download voice models.
TTS_ENABLED=true
TTS_ENGINE=piper
# TTS_SPEED=1
# PIPER_BIN=piper
PIPER_MODEL=models/piper/en_US-lessac-medium.onnx
# PIPER_CONFIG=models/piper/en_US-lessac-medium.onnx.json
